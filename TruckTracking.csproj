<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);.nuget/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="App_Data/**;.auth-test/**;.build-auth/**" />
    <None Remove="App_Data/**;.auth-test/**;.build-auth/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
  </ItemGroup>
</Project>
